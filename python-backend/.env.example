APP_NAME=EditFrame Python API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://editframe:editframe@postgres:5432/editframe
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STORAGE_ROOT=/data/editframe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_CHECKPOINT=/app/models/sam2.1_hiera_tiny.pt
SAM2_OFFLOAD_VIDEO_TO_CPU=true
SAM2_OFFLOAD_STATE_TO_CPU=true
